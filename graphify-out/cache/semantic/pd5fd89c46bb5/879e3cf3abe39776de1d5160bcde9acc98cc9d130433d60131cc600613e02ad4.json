"label": "Public Submissions Management Page", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 30-31 (Figure 28)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_reply_to_inquiry_modal", "label": "Reply to Inquiry Modal", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "p. 31 (Figure 29)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_restricted_developer_interface", "label": "Section 3.1.4: Restricted Developer Interface", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "p. 31, section 3.1.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Developer interface must be minimal and not reproduce the curator application; limited to curator account onboarding/activation/disabling/removal and approved AR asset deployment, with all actions authenticated and audited. Routine specimen, location, request, report, FAQ, and public-content functions are not visible or accessible to the developer role."}, {"id": "docs_biosphere_srs_developer_page", "label": "Developer Page", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 31-32 (Figure 30)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_onboard_user_modal", "label": "Onboard User Modal (Developer)", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 32-33 (Figure 31)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_edit_user_modal_developer", "label": "Edit User Modal (Developer)", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "p. 33 (Figure 32)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Developer can update authorized curator account details/status when formally authorized but cannot view or assign passwords; password setup and recovery are completed only through secure email links, keeping credential control outside the developer role."}, {"id": "docs_biosphere_srs_new_ar_asset_modal", "label": "New AR Asset Modal", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 33-34 (Figure 33)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_edit_ar_asset_modal", "label": "Edit AR Asset Modal", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "p. 34 (Figure 34)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_public_qr_exhibit_interface", "label": "Section 3.1.5: Public QR Exhibit Interfaces", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 34-36, section 3.1.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QR exhibit pages must be mobile-optimized and show only approved images/educational content; internal fields, condition notes, storage locations, audit information, and curator-only remarks must never appear, keeping the public surface strictly limited to curator-approved and non-confidential data."}, {"id": "docs_biosphere_srs_qr_exhibit_page_no_ar", "label": "QR Exhibit Page (Without AR Action)", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "p. 35 (Figure 35)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_qr_exhibit_page_with_ar", "label": "QR Exhibit Page (With View in AR Action)", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 35-36 (Figure 36)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_biosphere_srs_camera_permission_policy", "label": "Camera Permission Request Policy", "file_type": "rationale", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 35-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera permission shall be requested only after a visitor explicitly starts an AR or scanning action, minimizing unnecessary access requests and respecting visitor privacy/consent expectations."}, {"id": "docs_biosphere_srs_faq_assistant_interface", "label": "Section 3.1.6: Controlled Knowledge-Based FAQ Assistant Interface", "file_type": "document", "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 36-37, section 3.1.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The FAQ assistant widget must present a clear museum-assistant identity, suggested questions, and a visible path to the General Inquiry form; it must disclose that answers are limited to curator-approved museum knowledge and must not appear to approve visits or process campus entry, preventing visitor confusion about its authority."}, {"id": "docs_biosphere_srs_br_10", "label": "BR-10: Public Approval", "file_type": "concept", "source_file": "docs/BioSphere-SRS.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only curator-approved information may ever reach the public site, Gallery, FAQ, QR pages, or AR content."}, {"id": "docs_biosphere_srs_br_11", "label": "BR-11: Storage Confidentiality", "file_type": "concept", "source_file": "docs/BioSphere-SRS.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detailed storage locations never appear outside authenticated curator functions."}, {"id": "docs_biosphere_srs_br_12", "label": "BR-12: Developer Restriction", "file_type": "concept", "source_file": "docs/BioSphere-SRS.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Developer role is not a curator role; strictly limited to curator onboarding/access-admin and approved AR asset deployment, never a general admin dashboard."}, {"id": "docs_biosphere_srs_br_18", "label": "BR-18: FAQ Boundary", "file_type": "concept", "source_file": "docs/BioSphere-SRS.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FAQ assistant is rule-based against curator-approved content only; unmatched questions fall back to the General Inquiry form rather than generating an answer."}], "edges": [{"source": "docs_biosphere_srs_user_management_page", "target": "docs_biosphere_srs_add_curator_modal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BioSphere-SRS.pdf", "source_location": "p. 27", "weight": 1.0}, {"source": "docs_biosphere_srs_user_management_page", "target": "docs_biosphere_srs_account_status_change_modal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 27-28", "weight": 1.0}, {"source": "docs_biosphere_srs_reports_page", "target": "docs_biosphere_srs_export_report_modal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 28-30", "weight": 1.0}, {"source": "docs_biosphere_srs_public_submissions_management_page", "target": "docs_biosphere_srs_reply_to_inquiry_modal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BioSphere-SRS.pdf", "source_location": "pp. 30-31", "weight": 1.0}, {"source": "docs_biosphere_srs_restricted_developer_interface", "target": "docs_biosphere_srs_developer_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score"