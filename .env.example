# Copy to .env.local and fill in real values. Never commit real values.

# Supabase project: Dashboard > Settings > API. Use the anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NestJS backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public origin users load the site from (scheme + host, no path). Required in
# deployed environments behind a reverse proxy: same-origin API handlers compare
# the browser's Origin header with this value. Leave unset for local dev, where
# the request URL's origin is used instead. Server-only: not NEXT_PUBLIC.
# APP_ORIGIN=https://biosphere.dcism.org

# Minutes of inactivity before a signed-in session ends (REQ-4.1-05). Required.
# 30 is the team's proposed value, pending final client acceptance.
# NEXT_PUBLIC values are fixed at build time: rebuild after changing this.
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30
