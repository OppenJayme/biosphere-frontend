# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Isolated browser tooling: dependencies and potentially sensitive run artifacts.
/tools/browser/node_modules/
/tools/browser/artifacts/
/tools/browser/.playwright/
/tools/browser/.playwright-cli/
/tools/browser/auth.json
/tools/browser/storage-state*.json
/tools/browser/*profile*/

# 3D model pipeline working files: specimen photos, paid Tripo output, batch state.
/3d-models/
tripo-out/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
